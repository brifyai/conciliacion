# Copia este archivo a `.env` (local) o carga estas variables en Coolify.
# NO subas el `.env` real al repo: el .gitignore ya lo excluye.

# --- Supabase (backend) ---
VITE_SUPABASE_URL=https://brifii-data.aintelligence.cl
VITE_SUPABASE_ANON_KEY=

# --- Ingreso automático (cuenta de servicio) ---
# OJO: en un frontend Vite estas variables quedan en el bundle público.
VITE_AUTH_EMAIL=
VITE_AUTH_PASSWORD=

# --- Inspección con IA (opcional) ---
# Las *_API_KEY van SIN prefijo VITE_: se leen solo en el servidor
# (proxy de Vite en dev, server.js en producción) y no llegan al bundle.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
VITE_OPENCODE_MODEL=qwen3.7-max

# --- PDF a Excel (opcional, proveedor de visión aparte) ---
PDF_MODEL_API_KEY=
PDF_MODEL_BASE_URL=
VITE_MODELO_PDF=qwen3.6-flash

# --- Runtime del servidor (Docker) ---
PORT=3000
